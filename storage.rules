rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function prof() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && prof().active == true; }
    function writer() { return active() && prof().role in ['admin', 'adv']; }
    function monthOpen(m) { return !firestore.exists(/databases/(default)/documents/months/$(m)) || firestore.get(/databases/(default)/documents/months/$(m)).data.status != 'clos' || prof().role == 'admin'; }

    // Exports Odoo (.xls / .xlsx), 30 Mo max
    match /imports/{month}/{file} {
      allow read: if active();
      allow create: if writer() && monthOpen(month) && request.resource.size < 30 * 1024 * 1024;
      allow delete: if writer() && monthOpen(month);
    }
    // Factures PDF contrôlées, 20 Mo max
    match /invoices/{month}/{file} {
      allow read: if active();
      allow create: if writer() && monthOpen(month) && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
      allow delete: if writer() && monthOpen(month);
    }
    match /{all=**} { allow read, write: if false; }
  }
}
