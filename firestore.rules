rules_version = '2';
// Plateforme de facturation OTIS — accès réservé aux comptes actifs, écritures selon le rôle.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function hasRole(roles) { return active() && me().role in roles; }

    // Profils : lecture de son propre profil ; l'admin voit tout. Écritures uniquement par Cloud Functions.
    match /users/{uid} {
      allow read: if active() && (uid == request.auth.uid || hasRole(['admin']));
      allow write: if false;
    }
    // Grilles, agences et règles : lecture par tous les comptes actifs, modification par l'admin.
    match /config/{doc} {
      allow read: if active();
      allow write: if hasRole(['admin']);
    }
    // Mois de facturation : l'ADV modifie un mois ouvert ; seul l'admin touche un mois clôturé (réouverture).
    match /months/{month} {
      allow read: if active();
      allow create: if hasRole(['admin', 'adv']) && month.matches('^[0-9]{4}-[0-9]{2}$');
      allow update: if hasRole(['admin']) || (hasRole(['adv']) && resource.data.status != 'clos');
      allow delete: if false;
      match /pdfs/{pdf} {
        allow read: if active();
        allow write: if hasRole(['admin']) || (hasRole(['adv']) && get(/databases/$(database)/documents/months/$(month)).data.status != 'clos');
      }
    }
    // Journal : lecture admin, écriture uniquement par Cloud Functions, jamais modifiable.
    match /logs/{id} {
      allow read: if hasRole(['admin']);
      allow write: if false;
    }
  }
}
